# Run Hound 0.5.0: settings for run-hound.compose.yml (published images) and docker-compose.yml (built from source).
#
#   cp .env.example .env                           # next to the compose file
#   mkdir -p runs
#   docker compose -f run-hound.compose.yml up     # published images, no clone (Podman: podman compose -f ...)
#   docker compose up --build                      # in a clone: the same stack built from source
#
# Every value below is optional: the compose file has the same defaults. .env is git-ignored, so keep your own
# changes there. All published ports are bound to 127.0.0.1 only: nothing here is reachable from your network.

# ---- Run Hound -----------------------------------------------------------------------------------------------

# Host port of the Run Hound web UI: http://localhost:4000
RUNHOUND_HOST_PORT=4000

# Folder on your machine where reports are written (one folder per run). Create it before the first run so the
# files belong to you.
RUNHOUND_RUNS_DIR=./runs

# Host names the safety gate accepts besides localhost and private addresses. The default lists the test apps in
# the compose file and the names Docker and Podman give your machine. Add only hosts you own (comma separated):
# this list is NOT checked for ownership.
RUNHOUND_ALLOWED_HOSTS=kennel,kennel-clean,fernway,fernway-bugs,classic-post,spa-fetch,login,cross-origin-api,multi-form,host.docker.internal,host.containers.internal

# ---- AI (optional, off by default) ---------------------------------------------------------------------------
# A model can review the plan, suggest extra flows and explain findings; real checks still decide pass or fail.
# You can also set all of this on the Settings page instead. Values set here are locked there.
# Only redacted page structure is sent (labels, field types, button names), never values, cookies or screenshots.
#
# Ollama on your machine (Podman: host.containers.internal; Docker: host.docker.internal). Ollama must listen on
# all interfaces for the container to reach it: OLLAMA_HOST=0.0.0.0 ollama serve
# RUNHOUND_AI=1
# RUNHOUND_AI_PROVIDER=ollama
# RUNHOUND_AI_BASE_URL=http://host.containers.internal:11434/v1
# RUNHOUND_AI_MODEL=qwen3:8b
#
# Any OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp, OpenAI, OpenRouter, Groq, ...). A remote endpoint
# needs your consent: RUNHOUND_AI_ALLOW_REMOTE=1. RUNHOUND_AI_MODEL is the model id as your endpoint names it.
# RUNHOUND_AI=1
# RUNHOUND_AI_PROVIDER=openai-compatible
# RUNHOUND_AI_BASE_URL=https://api.openai.com/v1
# RUNHOUND_AI_MODEL=
# RUNHOUND_AI_API_KEY=
# RUNHOUND_AI_ALLOW_REMOTE=1
#
# Amazon Bedrock (always remote): a Bedrock API key, AWS access keys, or an AWS profile (static keys,
# credential_process or IAM Identity Center after `aws sso login`; assume-role profiles are not supported yet).
# Name the profile with RUNHOUND_AI_AWS_PROFILE (or AWS_PROFILE; else "default"). In the container, uncomment the
# read-only ~/.aws mount and the AWS_CONFIG_FILE / AWS_SHARED_CREDENTIALS_FILE lines in docker-compose.yml: static
# keys then always work; SSO works only when the container runs as pwuser (HOME=/home/pwuser), and
# credential_process needs its program inside the container. A Bedrock API key or AWS access keys need no mount.
# RUNHOUND_AI_MODEL is a Bedrock model id (or inference profile) your account can use in that region.
# RUNHOUND_AI=1
# RUNHOUND_AI_PROVIDER=bedrock
# RUNHOUND_AI_REGION=us-east-1
# RUNHOUND_AI_MODEL=
# AWS_BEARER_TOKEN_BEDROCK=
# RUNHOUND_AI_AWS_PROFILE=
# RUNHOUND_AI_ALLOW_REMOTE=1
#
# Which jobs the model does (default: all three).
# RUNHOUND_AI_FEATURES=review,suggest,explain
#
# Per-request time limit in ms (default 120000). Raise it for a slow model or a busy GPU.
# RUNHOUND_AI_TIMEOUT_MS=300000

# ---- Test accounts (optional): signed-in runs and access checks ------------------------------------------------
# Two accounts you own on the app you test (A and B), so Run Hound can sign in before testing pages behind a login
# (`run <url> --as a`, or "Sign in as" in the UI) and check whether account B, or a signed-out visitor, can read
# account A's data. You can also set them on the Settings page (saved in ./runs/.config/accounts.json, passwords
# included, so keep that folder private); a value set here overrides the saved one, field by field. Passwords never
# appear in reports or logs. The login URL must pass the same safety gate as a target (localhost, private addresses,
# RUNHOUND_ALLOWED_HOSTS); inside the compose network that means e.g. http://fernway:4110/login.
# RUNHOUND_ACCOUNT_A_LOGIN_URL=http://host.docker.internal:5173/login
# RUNHOUND_ACCOUNT_A_USERNAME=alice@example.test
# RUNHOUND_ACCOUNT_A_PASSWORD=
# RUNHOUND_ACCOUNT_A_LABEL=Alice
# RUNHOUND_ACCOUNT_B_LOGIN_URL=http://host.docker.internal:5173/login
# RUNHOUND_ACCOUNT_B_USERNAME=bob@example.test
# RUNHOUND_ACCOUNT_B_PASSWORD=
# RUNHOUND_ACCOUNT_B_LABEL=Bob
#
# A and B must not see each other's data (different users, not teammates in one workspace): true (default) plans the
# check that B can't read A's records; set false when they share data on purpose.
# RUNHOUND_ACCOUNTS_ISOLATED=true

# ---- Kennel: the deliberately broken booking app ------------------------------------------------------------
# In the UI, test http://kennel:3000/book (bugs on) and http://kennel-clean:3000/book (clean mode).

# Bugs to turn on in the "kennel" service: all (every V0 and V1 bug), none (clean mode), or a comma list.
#   V0 (the form):  F01-F06 features, A01-A09 accessibility, S01-S04 security
#   V1 (the page):  F07 dead Refresh button outside the form, S05 no security headers, S06 session cookie
#                   without HttpOnly, S07 CORS trusts any origin with credentials, S08 public source maps
# Full list with what each bug changes: fixtures/kennel/bugs.json and fixtures/kennel/CONTRACT.md.
KENNEL_BUGS=all

# Host ports for opening Kennel in your own browser (inside the compose network it is always port 3000).
KENNEL_HOST_PORT=3000
KENNEL_ANALYTICS_HOST_PORT=3001
KENNEL_CLEAN_HOST_PORT=3100
KENNEL_CLEAN_ANALYTICS_HOST_PORT=3101

# ---- Fernway: a Lovable/Bolt-style SaaS app (Vite, React, Tailwind CSS, Radix/shadcn-style components) ---------
# In the UI, test http://fernway:4110/ (clean mode: any confirmed finding is a false positive) and
# http://fernway-bugs:4110/ (planted bugs). Pages: / /signup /login /onboarding /app /app/settings /app/help.

# Bugs to turn on in the "fernway-bugs" service: all (every bug), none (clean mode), or a comma list such as W01,W06.
#   W01 waitlist select without a name   W02 newsletter error swallowed    W03 quick add double submit
#   W04 bio dropped before saving        W05 unnamed icon buttons          W06 live secret key in the bundle
#   W07 focus ring removed on sign-up    W08 no security headers           W09 session cookie without HttpOnly
#   W10 sign-in errors not announced
#   V01-V05, the access bugs for signed-in runs (as alex@fernway.test, with sam@fernway.test as account B):
#   V01 any user's profile readable      V02 every user's tasks listed     V03 workspace APIs need no session
#   V04 profile stores role and plan     V05 /app/help answers 404 when opened directly
# Signed in as Alex, /app shows V02, V03 and V05 (its sidebar links to /app/help); /app/settings shows V01, V03, V04.
# Full list with the page each bug is on: fixtures/fernway/bugs.json and fixtures/fernway/CONTRACT.md.
FERNWAY_BUGS=all

# Host ports for opening Fernway in your own browser (inside the compose network it is always port 4110).
FERNWAY_HOST_PORT=4110
FERNWAY_BUGS_HOST_PORT=4111

# ---- Sample apps: well-built apps (any confirmed finding on them is a false positive) --------------------------
# In the UI, test http://classic-post:4101/signup, http://spa-fetch:4102/, http://login:4103/,
# http://cross-origin-api:4104/ and http://multi-form:4106/ (three forms on one page). These are the host ports for
# opening them in your own browser.
CLASSIC_POST_HOST_PORT=4101
SPA_FETCH_HOST_PORT=4102
LOGIN_HOST_PORT=4103
MULTI_FORM_HOST_PORT=4106
# cross-origin-api always uses 4104 (page) and 4105 (its API): the page calls the API on the same port number.
