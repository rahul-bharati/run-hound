{
  "name": "@run-hound/desktop",
  "private": true,
  "description": "Run Hound desktop app",
  "homepage": "https://run-hound.rahulbharati.com/",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main.js",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./env": "./src/env.ts",
    "./config": "./src/config.ts",
    "./entry": "./src/entry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "electron:fetch": "install-electron --no",
    "start": "pnpm electron:fetch && pnpm build && electron .",
    "test:launch": "pnpm electron:fetch && pnpm build && node scripts/launch-check.mjs",
    "dist": "pnpm build && node scripts/dist.mjs",
    "dist:dir": "pnpm build && node scripts/dist.mjs --dir",
    "browsers:fetch": "node scripts/fetch-browsers.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "run-hound": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "dev.runhound.desktop",
    "productName": "Run Hound",
    "artifactName": "Run-Hound-${version}-${os}-${arch}${env.RUNHOUND_UNSIGNED_SUFFIX}.${ext}",
    "executableName": "run-hound",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Run Hound <contact@rahulbharati.dev>",
      "icon": "assets/icon.png",
      "synopsis": "AI-assisted UI testing for AI-built apps"
    },
    "deb": {
      "packageName": "run-hound",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2",
        "libgbm1",
        "libdrm2"
      ]
    },
    "rpm": {
      "packageName": "run-hound",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(alsa-lib or libasound2)",
        "(mesa-libgbm or libgbm1)",
        "(libdrm or libdrm2)"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "build/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*",
          "!.links",
          "!.links/**",
          "!**/DEPENDENCIES_VALIDATED"
        ]
      }
    ]
  }
}
